  },
  "lighting": {
    "shading": "Lambert",
    "ambient": [
      0.3,
      0.27,
      0.2
    ],
    "lights": [
      {
        "dirToLight": [
          -0.35,
          0.65,
          0.68
        ],
        "color": [
          1.0,
          0.91,
          0.72
        ],
        "intensity": 0.82
      },
      {
        "dirToLight": [
          0.58,
          0.18,
          0.8
        ],
        "color": [
          1.0,
          0.76,
          0.42
        ],
        "intensity": 0.28
      }
    ],
    "space": "camera_space",
    "formula": "C = tex_linear * clamp(ambient + sum_k(intensity_k * color_k * max(dot(N, L_k), 0)), 0, 1), L_k = normalize(dirToLight)",
    "nodeScaleFloor": 0.001
  },
  "layer": {
    "id": "sunflower_forehead",
    "asset": "sunflower_forehead_model",
