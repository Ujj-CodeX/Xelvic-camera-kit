{
  "schemaVersion": 1,
  "id": "sunflower_forehead",
  "name": "Sunflower Forehead",
  "description": "A single realistic golden sunflower accent placed on the subject-left upper forehead/temple, just above the eyebrow and overlapping the hairline slightly. It is a small face-attached ornament, not a crown or flower cluster.",
  "engineContract": "xfilter-face-3d/1",
  "preview": {
    "path": "preview.jpg",
    "role": "catalogue_proxy_head"
  },
  "assets": [
    {
      "id": "sunflower_forehead_model",
      "path": "assets/sunflower_forehead.glb",
      "mediaType": "model/gltf-binary",
      "sha256": "6ce853c60719692f1302f301a6ac9ac73b079debc1e71c2144c9d30977e1cb8d",
      "bytes": 507556
    }
  ],
  "units": {
    "distance": "face_width",
    "faceWidth": 1.0
  },
  "faceAxes": {
    "source": "canonical_face_model",
    "x": "subject_right",
    "y": "up",
    "z": "toward_camera",
    "mirrorPolicy": "mirror_final_projection_once",
    "primarySide": "subject_left",
    "sideMapping": "negative_x (VERIFY against the canonical face model; the proxy preview shows subject-left on viewer-right)"
  },
  "anchors": {
    "head_center": {
      "offsetFW": [
        0.0,
        0.2,
        -0.12
      ],
      "definition": "cheek_mid + R * (FW * [0, 0.20, -0.12]); cheek_mid = M * (c234 + c454) / 2"
    },
    "forehead_left_hairline": {
      "landmarks": [
        {
          "id": 297,
          "weight": 0.5
        },
        {
          "id": 338,
          "weight": 0.25
        },
        {
          "id": 332,
          "weight": 0.25
        }
      ],
      "offsetFW": [
        -0.01,
        0.05,
        0.03
      ],
      "definition": "0.50*L297 + 0.25*L338 + 0.25*L332 + FW * [-0.01, 0.05, 0.03] (subject-left upper forehead hairline)"
    },
    "faceWidthDefinition": "FW = ||M*c234 - M*c454||; cheek_mid = M * (c234 + c454) / 2"
  },
  "calibration": {
    "tunableFields": {
      "layer.offsetFW": [
        0.0,
        0.06,
        0.02
      ],
      "layer.scale": 0.9,
      "forehead_left_hairline.offsetFW": [
        -0.01,
        0.05,
        0.03
      ],
      "head_center.offsetFW": [
        0.0,
        0.2,
        -0.12
      ],
      "headProxy.radiiFW": [
        0.56,
        0.66,
        0.68
      ],
      "faceMesh.pushBackFW": 0.015,
      "spring.stiffness": 90.0,
      "spring.gain": 0.35,
      "spring.maxAngleDeg": 8.0
    },
    "projection": {
      "camera": "same perspective camera used to compute M",
      "fieldOfView": "base-SDK camera FOV (VERIFY once on device)"
    },
    "placementNotes": "The flower origin is its central seed disk. Attached to custom landmark anchor forehead_left_hairline (#297, #338, #332) with anchor offsetFW [-0.01, 0.05, 0.03] and layer.offsetFW [0.0, 0.06, 0.02] at scale 0.9."
  },
  "model": {
    "asset": "sunflower_forehead_model",
    "gltfVersion": "2.0",
    "scene": "SunflowerForeheadScene",
