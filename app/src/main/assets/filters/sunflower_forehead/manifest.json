      "latSegments": 16,
      "lonSegments": 24,
      "pushBackFW": 0.0,
      "clearanceRatioMin": 1.1,
      "measuredRestClearanceRatio": 1.37337186
    },
    "sunflower": {
      "depthTest": "LESS",
      "depthWrite": true,
      "culling": "OFF"
    },
    "hairSegmentation": "none",
    "hairRelation": "The bloom sits in front of the hairline by design; no hair segmentation or hair occlusion is used."
  },
  "behaviors": {
    "timebase": {
      "clock": "render_seconds",
      "dtClamp": [
        0.001,
        0.05
      ],
      "faceAcquired": "first frame with a tracked face after none, including the first frame"
    },
    "composition": {
      "scale": "restScale * product(activeClipScales) * product(driverFactors) * lifecycleFade",
      "rotation": "R_spring_local * R_clip",
      "translation": "rest",
      "skipHiddenTierNodes": true,
      "skipDisabledTierBehaviors": true
    },
    "clips": [
      {
        "id": "idle_sway",
        "glbAnimation": "idle_sway",
        "durationSec": 3.2,
        "loop": true,
        "interpolation": "LINEAR",
        "rotationInterpolation": "SLERP",
        "startEvent": "face_acquired",
        "holdLast": false,
        "targets": "sunflower_pivot"
      },
      {
        "id": "bloom_in",
        "glbAnimation": "bloom_in",
        "durationSec": 1.0,
        "loop": false,
        "holdLast": true,
        "interpolation": "LINEAR",
        "startEvent": "face_acquired",
        "targets": "sunflower_pivot"
      },
      {
        "id": "burst",
        "glbAnimation": "burst",
        "durationSec": 0.9,
        "loop": false,
        "holdLast": false,
        "interpolation": "LINEAR",
        "targets": "sunflower_pivot"
      }
    ],
    "trigger": {
      "id": "burst_on_open",
      "clip": "burst",
      "signal": "jawOpen",
      "valuePolicy": "hold_last_tracker_value_between_results",
      "armedInitially": true,
      "risingAbove": 0.55,
      "fallingBelow": 0.35,
      "cooldownMs": 900,
      "restart": "ignore_if_playing",
      "fireAt": "rising_edge_when_armed_and_cooldown_elapsed"
    },
    "driver": {
      "id": "smile_swell",
      "signal": "mean(mouthSmileLeft,mouthSmileRight)",
      "normalization": {
        "inputRange": [
          0.25,
          0.75
        ],
        "clamp": [
          0.0,
          1.0
        ],
        "easing": "smoothstep",
        "equation": "u = clamp((x - 0.25) / (0.75 - 0.25), 0, 1); u = u*u*(3 - 2*u)"
      },
      "target": "1.0 + 0.12*u",
      "smoothing": {
        "equation": "y += (target-y) * (1-exp(-dt/0.120))",
        "timeConstantSec": 0.12,
        "initial": 1.0
      },
      "targets": "sunflower_petals_*_lod_*",
      "effect": "uniform_scale_multiplier"
    },
    "spring": {
      "id": "head_inertia",
      "targets": "sunflower_pivot",
      "angularVelocity": "rotvec(transpose(R_previous)*R_current)/dt",
      "angularVelocityFrame": "sunflower_root_body_frame",
      "angularAcceleration": "finite_difference_low_passed",
      "lowPassTimeConstantSec": 0.04,
      "maxAngularAccelerationRadPerSec2": 80.0,
      "initialState": {
        "a": [
          0,
          0,
          0
        ],
        "b": [
          0,
          0,
          0
        ]
      },
      "stiffness": 90.0,
      "dampingRatio": 0.3,
      "damping": "2*zeta*sqrt(stiffness)",
      "gain": 0.35,
      "substepMaxSec": 0.008333333333333333,
      "maxAngleDeg": 8.0,
      "localConversion": "inverse(R_parent) * exp([a]x) * R_parent"
    },
    "lifecycle": {
      "faceLost": {
        "holdMs": 150,
        "fadeMs": 200,
        "fadeScale": "1 - tau^3",
        "afterFade": "hide_layer_and_reset_all_behavior_state"
      },
      "resetState": {
        "clipTimes": 0,
        "drivers": 1.0,
        "springs": 0,
        "triggersArmed": true,
        "lastFire": "-infinity"
      },
      "reacquiredDuringHoldOrFade": {
        "cancelFade": true,
        "easeRootScaleToOneMs": 100,
        "preserveBehaviorState": true,
        "replayBloom": false
      }
    }
  },
